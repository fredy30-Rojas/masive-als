__pycache__/
*.pyc
# Binarios y artefactos de compilación
*.exe
*.bin
*.dll
*.tar.gz
*.zip
# Logs y archivos temporales de depuración
*.log
*_err.txt
# Datos masivos de docking (265k archivos PDBQT; se regeneran con los scripts)
compounds/
gpu_dock/

# Cache de coordenadas del barrido del PDB (se vuelven a descargar)
analysis/ligandos_cristal/_pdb/

# Receptor del CR: la cache pesada se regenera con construir_receptor_cr.py; lo que
# se guarda en git son los receptores ya preparados (modelos/*.pdbqt) y los resumenes
analysis/_cr_receptor/pdb/
analysis/_cr_receptor/modelos/*.pdb
analysis/_cr_receptor/modelos/*.json
analysis/_cr_receptor/ligands/
analysis/_cr_receptor/out/
analysis/_cr_receptor/fondo_ligands/
analysis/_cr_receptor/fondo_out/

# Descargas pesadas del suplementario (se bajan con el comando del informe)
analysis/_xl20_fig/supp.zip
analysis/_xl20_fig/*.pdf
analysis/_xl20_fig/*.xlsx
analysis/_xl20_fig/*.jpg
analysis/_xl20_fig/suppfig1_full.png

# Banco de calibracion TBK1: lo pesado se regenera con los scripts; en git van
# los scripts, el plan, el receptor preparado y la lista del banco.
analysis/calibracion_tbk1/ligands/
analysis/calibracion_tbk1/out/
analysis/calibracion_tbk1/_lote_tmp/
analysis/calibracion_tbk1/_control_bx795/out/
analysis/calibracion_tbk1/actividades_tbk1.json
analysis/calibracion_tbk1/receptor_tbk1.json

# Validacion estandar sobre DUD-E CDK2: igual que TBK1. Lo pesado se regenera con
# preparar_banco_cdk2.py desde el tarball de DUD-E; en git van los scripts, el
# informe, el receptor preparado, la caja y los ficheros .ism (la identidad del
# banco), que es lo que hace falta para rehacer cualquier cuenta.
analysis/calibracion_dude_cdk2/ligands/
analysis/calibracion_dude_cdk2/out/
analysis/calibracion_dude_cdk2/_lote_tmp/
analysis/calibracion_dude_cdk2/_control_cdk2/*/out/
analysis/calibracion_dude_cdk2/_control_cdk2/*/ligands/
analysis/calibracion_dude_cdk2/receptor_cdk2.json
# Las 56 poses y el receptor copiado se regeneran con preparar_poses_gnina.py; los
# scripts de WSL SI van en git, que son el registro de como se corrio GNINA.
analysis/calibracion_dude_cdk2/_gnina_poses/out/
analysis/calibracion_dude_cdk2/_gnina_poses/receptor_cdk2.pdbqt
analysis/calibracion_dude_cdk2/resultados_cdk2.csv
analysis/calibracion_dude_cdk2/motor_stdout.log
analysis/calibracion_dude_cdk2/encadenado_stdout.log
analysis/calibracion_dude_cdk2/*.tar.gz
analysis/calibracion_dude_cdk2/*.sdf.gz
analysis/calibracion_dude_cdk2/*.mol2.gz
